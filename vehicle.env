# Vehicle display runtime settings

# Flask
FLASK_ENV=production
DEBUG=False

# Server
HOST=0.0.0.0
PORT=5000

# Camera
CAMERA_ENABLED=True
CAMERA_SOURCE=0
CAMERA_RESOLUTION_W=1280
CAMERA_RESOLUTION_H=720
CAMERA_FPS=30
LANE_DETECTION_ENABLED=True
LANE_DETECTION_INTERVAL=0.1
LANE_ANGLE_UPDATE_INTERVAL=0.05
LANE_ANGLE_LOG_ENABLED=False

# Sensors
SENSORS_ENABLED=True
USE_GPIO=False

# CAN / controller
CAN_ENABLED=True
CAN_CHANNEL=can0
CAN_INTERFACE=socketcan
CAN_FD=True
CAN_BITRATE=500000
CAN_DBITRATE=2000000
CAN_RESTART_MS=100
CAN_TXQUEUELEN=1000
CAN_TX_201_INTERVAL=0.012
CAN_TX_300_INTERVAL=0.1
CAN_LOG_ENABLED=True
CAN_RX_LOG_ENABLED=True
CAN_LOG_INTERVAL=0.2
CONTROLLER_ENABLED=True
CONTROLLER_LOG_ENABLED=True
CONTROLLER_GUIDE_MAX_ANGLE=60
CONTROLLER_STEER_INVERT=False

# Bluetooth SPP Android app command server
BLUETOOTH_ENABLED=True
BLUETOOTH_LOG_RAW=True
BLUETOOTH_BIND_ADDRESS=00:00:00:00:00:00
BLUETOOTH_RFCOMM_CHANNEL=1
BLUETOOTH_RESTART_DELAY=2

# PDW distance thresholds (cm)
PDW_SAFE_DISTANCE=120
PDW_PROXIMITY_DISTANCE=60
PDW_DANGER_DISTANCE=30

# Buzzer
BUZZER_ENABLED=True
BUZZER_GPIO_PIN=18

# Runtime mode
SIMULATION_MODE=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=vehicle_display.log
