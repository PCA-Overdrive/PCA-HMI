# 차량 디스플레이 환경 설정

# Flask 환경
FLASK_ENV=production
DEBUG=False

# 서버 설정
HOST=0.0.0.0
PORT=5000

# 카메라 설정
CAMERA_ENABLED=True
CAMERA_SOURCE=1
CAMERA_BACKEND=MSMF
CAMERA_RESOLUTION_W=1280
CAMERA_RESOLUTION_H=720
CAMERA_FPS=30

# 센서 설정
SENSORS_ENABLED=True
USE_GPIO=False

# PDW 거리 기준 (cm)
PDW_SAFE_DISTANCE=120
PDW_PROXIMITY_DISTANCE=60
PDW_DANGER_DISTANCE=30

# 부저 설정
BUZZER_ENABLED=True
BUZZER_GPIO_PIN=

# 시뮬레이션 모드 (개발 중에는 True, 실제 센서 사용 시 False)
SIMULATION_MODE=True

# 로깅
LOG_LEVEL=INFO
LOG_FILE=vehicle_display.log
